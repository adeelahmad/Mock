#!/usr/bin/env bash
# Mock (prebuilt LXC template): replaces /usr/local/bin/mock with a release's binary, checks it
# against the release's checksums.txt, and restarts the service. Data in /var/lib/mock stays.
#   update                  latest release
#   MOCK_TAG=v0.2.0 update  a given tag
set -euo pipefail
REPO="${MOCK_REPO:-adeelahmad/Mock}"
TAG="${MOCK_TAG:-}"
case "$(dpkg --print-architecture)" in amd64 | arm64) ARCH="$(dpkg --print-architecture)" ;; *) echo "update: unsupported architecture" >&2; exit 1 ;; esac
if [[ -z "$TAG" ]]; then
  TAG="$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/${REPO}/releases/latest")"
  TAG="${TAG##*/}"
fi
if [[ "$TAG" == "$(cat /etc/mock-release 2>/dev/null)" ]]; then echo "Mock is already at $TAG"; exit 0; fi

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
BASE="https://github.com/${REPO}/releases/download/${TAG}"
echo "Downloading Mock $TAG ($ARCH)"
curl -fsSL "$BASE/mock-linux-$ARCH" -o "$TMP/mock-linux-$ARCH"
curl -fsSL "$BASE/checksums.txt" -o "$TMP/checksums.txt"
(cd "$TMP" && grep " mock-linux-$ARCH\$" checksums.txt | sha256sum -c --quiet)
install -m 0755 "$TMP/mock-linux-$ARCH" /usr/local/bin/mock.new && mv /usr/local/bin/mock.new /usr/local/bin/mock
echo "$TAG" >/etc/mock-release
systemctl restart mock
echo "Updated Mock to $TAG"
